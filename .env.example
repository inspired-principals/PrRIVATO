AI_PROVIDER=local
LOCAL_MODEL_URL=http://127.0.0.1:11434/v1/chat/completions
LOCAL_MODELS=your-installed-model-name

# Remote inference is disabled by default. Enable only after approving that user prompts
# may be sent to OpenRouter; its free model list is used as the fallback chain.
# AI_PROVIDER=openrouter
# OPENROUTER_API_KEY=your-openrouter-api-key
# OPENROUTER_MODELS=provider/model:free,provider/another-model:free